+fn is_ignored(client: &Client) -> bool {
+    std::env::var("HYPRSESSION_IGNORE_CLASSES")
+        .map(|list| {
+            list.split(',')
+                .map(|c| c.trim().to_lowercase())
+                .filter(|c| !c.is_empty())
+                .any(|c| c == client.class.to_lowercase() || c == client.initial_class.to_lowercase())
+        })
+        .unwrap_or(false)
+}
