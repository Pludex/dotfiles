(defalias
  tilda S-`     ;; ~ (Tilde)
  excl  S-1     ;; ! (Exclamation mark)
  at    S-2     ;; @ (At)
  hash  S-3     ;; # (Hash / Number sign)
  dlr   S-4     ;; $ (Dollar)
  pct   S-5     ;; % (Percent)
  caret S-6     ;; ^ (Caret)
  amp   S-7     ;; & (Ampersand)
  ast   S-8     ;; * (Asterisk)
  lpar  S-9     ;; ( (Left Parenthesis)
  rpar  S-0     ;; ) (Right Parenthesis)
  unds  S--     ;; _ (Underscore)
  plus  S-=     ;; + (Plus)

  lbrace S-[    ;; { (Left Brace)
  rbrace S-]    ;; } (Right Brace)
  pipe   S-\    ;; | (Pipe / Vertical bar)
  colon  S-;    ;; : (Colon)
  dquo   S-'    ;; " (Double Quote)
  lt     S-,    ;; < (Less than)
  gt     S-.    ;; > (Greater than)
  quest  S-/    ;; ? (Question mark)
)

(defsrc
`          1          2          3          4          5          6          7          8          9          0          -          =
tab        q          w          e          r          t          y          u          i          o          p          [          ]          \
caps       a          s          d          f          g          h          j          k          l          ;          '          enter
           z          x          c          v          b          n          m          ,          .          /
lsft       rsft       lalt
spc
end
)

(deflayer programmer-dvorak
@dlr       @amp       [          @lbrace    @rbrace    @lpar      =          @ast       @rpar      @plus      ]          @excl      @hash
tab        ;          ,          .          p          y          f          g          c          r          l          /          @at        \
esc        a          o          e          u          i          d          h          t          n          s          -          enter
           '          q          j          k          x          b          m          w          v          z
@pdv_shift @pdv_shift @alt
@spc_ly
@to_qw
)

;; Letters here are explicit S-<letter> so they come out uppercase.
;; (Shift is now consumed by kanata for layer-switching, so the OS
;; never sees it and can no longer auto-capitalize on its own.)
(deflayer programmer-dvorak-shift
@tilda     @pct       7          5          3          1          9          0          2          4          6          8          `
tab        @colon     @lt        @gt        S-p        S-y        S-f        S-g        S-c        S-r        S-l        @quest     @caret     @pipe
esc        S-a        S-o        S-e        S-u        S-i        S-d        S-h        S-t        S-n        S-s        @unds      enter
           @dquo      S-q        S-j        S-k        S-x        S-b        S-m        S-w        S-v        S-z
_          _          _
@spc_ly
@to_qw
)
;; Press and hold the space bar to activate.
(deflayer programmer-dvorak-space
tab        f1         f2         f3         f4         f5         f6         f7         f8         f9         f10        f11       f12
tab        @tilda     @pct       7          5          3          1          9          0          2          4          6          8          `
@dlr       @amp       [          @lbrace    @rbrace    @lpar      =          @ast       @rpar      @plus      ]          @excl      @hash
           @dquo      q          j          k          x          b          m          w          v          z
_          _          _
spc
@to_qw
)

(deflayer qwerty
`          1          2          3          4          5          6          7          8          9          0          -          =
tab        q          w          e          r          t          y          u          i          o          p          [          ]          \
esc        a          s          d          f          g          h          j          k          l          ;          '          enter
           z          x          c          v          b          n          m          ,          .          /
@qw_shift  @qw_shift  @alt
@spc_ly
@to_dv
)

;; Letters here are explicit S-<letter> for the same reason as above.
(deflayer qwerty-shift
@tilda     @excl      @at        @hash      @dlr       @pct       @caret     @amp       @ast       @lpar      @rpar      @unds      @plus
tab        S-q        S-w        S-e        S-r        S-t        S-y        S-u        S-i        S-o        S-p        @lbrace    @rbrace    @pipe
esc        S-a        S-s        S-d        S-f        S-g        S-h        S-j        S-k        S-l        @colon     @dquo      enter
           S-z        S-x        S-c        S-v        S-b        S-n        S-m        @lt        @gt        @quest
_          _          _
@spc_ly
@to_dv
)

;; Held while lalt is held, on top of whichever base layer is active.
;; Only h and l are overridden; everything else falls through (_).
(deflayer nav
_          _          _          _          _          _          _          _          _          _          _          _          _
_          _          _          _          _          _          _          _          _          _          _          _          _          _
_          _          _          _          _          _          @nav_left  _          _          @nav_right _          _          _
           _          _          _          _          _          _          _          _          _          _
_          _          _
_
_
)

(defalias
  to_dv (layer-switch programmer-dvorak)
  to_qw (layer-switch qwerty)

  ;; spc_ly (tap-hold 250 250 spc (layer-toggle programmer-dvorak-space))
  ;; spc_ly (tap-hold-press 300 300 spc (layer-toggle programmer-dvorak-space))
  spc_ly (tap-hold 250 250 spc (layer-while-held programmer-dvorak-space))

  pdv_shift (layer-while-held programmer-dvorak-shift)
  qw_shift  (layer-while-held qwerty-shift)

  alt (tap-hold 200 200 lalt (multi lalt (layer-while-held nav)))
  nav_left  (multi (release-key lalt) C-left)
  nav_right (multi (release-key lalt) C-right)
)
